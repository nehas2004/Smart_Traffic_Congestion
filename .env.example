# ============================================================
# TEAM SETUP — copy this file to .env.local after cloning
# Windows:  copy .env.example .env.local
# Mac/Linux: cp .env.example .env.local
# Then ask Athul for the actual API keys to fill in.
# ============================================================

# TomTom API (maps + routing + traffic)
NEXT_PUBLIC_TOMTOM_API_KEY=your_tomtom_api_key_here

# OpenWeather API (weather chip on dashboard)
NEXT_PUBLIC_OPENWEATHER_API_KEY=your_openweather_api_key_here

# AI Recommendation Backend (FastAPI — run separately on port 8000)
NEXT_PUBLIC_AI_BACKEND_URL=http://localhost:8000
